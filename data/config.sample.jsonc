// ISAC 全局配置模板 (J2, DEVELOPMENT_PLAN.md)
//
// 复制为 config.jsonc 后按需修改; 真实 API Key 必须自行填入, 不要提交到 git。
// 支持的 modality: chat (LLM 文本对话) / image_gen / stt / tts / embed / vision
// Provider 接入策略: 通用 OpenAI 兼容 API (任意 api_base + api_key + model)。
{
  "debug": false,
  "bot_id": "",

  // 日志与可观测性 (详见 docs/LOGGING.md)
  // level: 全局级别 debug | info | warning | error (debug=true 等价 level=debug)
  // format: console (开发彩色) | json (生产 ELK/Loki 采集)
  // per_module: 按模块前缀单独设级, 只放开个别链路的 debug 而不刷屏全局
  "logging": {
    "level": "info",
    "format": "console",
    "per_module": {
      // "isac.router": "debug",
      // "isac.gating": "debug"
    }
  },

  // 主 LLM (文生文): K2 已落地, OpenAI 兼容 chat/completions
  "llm": {
    "provider": "openai",
    // api_key 明文填写 (开发态); 生产环境可填 "secret:<key>" 引用 SecretStore 加密存储
    // (R5): 先设 env ISAC_SECRET_KEY (32 字节 base64), 再用 `isac secret set <key>` 存入
    // 明文, 配置中填 "secret:<key>"。env ISAC_LLM_API_KEY 仍最高优先级覆盖此处。
    "api_key": "sk-your-key",
    "base_url": "https://api.openai.com/v1",
    "model": "gpt-4o-mini"
    // ── U7 数据化可选键 ──────────────────────────────────────────
    // cost_tier / latency_tier: 本模型在 ModelRouter 的档位 (free|low|standard|high /
    //   fast|standard|slow), category 路由打分用; 缺省按能力快照标注或 standard。
    // model_family: prompt 文件变体选择用的模型族名 (缺省按模型名前缀推断,
    //   如 gpt-* → gpt, claude-* → claude); 新模型族在此声明即可匹配 prompts/ 变体。
    // "cost_tier": "low",
    // "latency_tier": "fast",
    // "model_family": "gpt"
  },

  // U7 category 路由: 委派任务 (delegate_task.category) 按类型选模型链, 经
  // ModelCatalog/ModelRouter 数据驱动选择 (能力/成本/延迟/可达性过滤)。
  // 四类默认画像见 isac/provider/category_routing.py; categories 节可覆盖任一字段
  // (operation/cost_ceiling/latency_target/requires_tools), 不改代码。
  "model_routing": {
    "categories": {
      // "chat": { "cost_ceiling": "free" },
      // "creative": { "cost_ceiling": "high" }
    }
  },

  // J2 多模态 Provider 数组: 用户可配置任意 OpenAI 兼容端点
  // 每个 Provider 接受 api_base + api_key + model + 可选 cost_tier/latency_tier
  // cost_tier: free | low | standard | high (ModelRouter 按成本过滤)
  // latency_tier: fast | standard | slow
  // kind 必填, 取值: image_gen | stt | tts | embed | vision | rerank
  "multimodal_providers": [
    // {
    //   "kind": "image_gen",
    //   "provider": "openai",
    //   "api_key": "sk-your-key",
    //   "base_url": "https://api.openai.com/v1",
    //   "model": "dall-e-3",
    //   "cost_tier": "low",
    //   "latency_tier": "standard"
    // },
    // S6 视频生成注册挂点 (default-off)。⚠ generate 仍抛 NotImplementedError:
    // 真实端点 (Sora/Runway/Kling 等) 开工前需二次确认; 配置后仅注册进 ModelCatalog,
    // 不触发调用, 仅 Agent 实际请求视频生成时才暴露"未实现"。
    // {
    //   "kind": "video_gen",
    //   "provider": "openai",
    //   "api_key": "sk-your-key",
    //   "base_url": "https://api.example.com/v1",
    //   "model": "sora-1"
    // },
    // {
    //   "kind": "stt",
    //   "provider": "openai",
    //   "api_key": "sk-your-key",
    //   "base_url": "https://api.openai.com/v1",
    //   "model": "whisper-1"
    // },
    // {
    //   "kind": "tts",
    //   "provider": "openai",
    //   "api_key": "sk-your-key",
    //   "base_url": "https://api.openai.com/v1",
    //   "model": "tts-1"
    // },
    // {
    //   "kind": "embed",
    //   "provider": "openai",
    //   "api_key": "sk-your-key",
    //   "base_url": "https://api.openai.com/v1",
    //   "model": "text-embedding-3-small"
    // },
    // {
    //   "kind": "vision",
    //   "provider": "openai",
    //   "api_key": "sk-your-key",
    //   "base_url": "https://api.openai.com/v1",
    //   "model": "gpt-4o"
    // },
    // {
    //   "kind": "rerank",
    //   "provider": "cohere",
    //   "api_key": "sk-your-key",
    //   "base_url": "https://api.cohere.ai/v1",
    //   "model": "rerank-english-v3.0",
    //   "protocol": "cohere",
    //   "cost_tier": "low",
    //   "latency_tier": "fast"
    // },
    // {
    //   "kind": "rerank",
    //   "provider": "jina",
    //   "api_key": "sk-your-key",
    //   "base_url": "https://api.jina.ai/v1",
    //   "model": "jina-reranker-v2-base-multilingual",
    //   "protocol": "jina"
    // }
    // 自托管 OpenAI 兼容端点示例 (如 vLLM / Ollama / 阿里通义 / 智谱):
    // {
    //   "kind": "image_gen",
    //   "provider": "custom",
    //   "api_key": "your-internal-key",
    //   "base_url": "https://internal.example.com/v1",
    //   "model": "your-image-model",
    //   "cost_tier": "free",
    //   "latency_tier": "fast"
    // }
  ],

  // 记忆子系统 (Q1 起默认开启: 纯 SQLite 零外部依赖, FTS5+BM25 稀疏检索 +
  // 对话写入回路立即可用, "越聊越熟"开箱生效; 不需要记忆时改 false)
  // embedding 配置了 api_key+model 时启用稠密 (向量) 召回 + RRF 融合 (CR3-H3):
  // 未配置时自动降级为纯稀疏检索, 不报错。dimension 必须与所选模型输出维度一致。
  "memory": {
    "enabled": true,
    "embedding": {
      // "provider": "openai",
      // "api_key": "sk-your-key",
      // "base_url": "https://api.openai.com/v1",
      // "model": "text-embedding-3-small",
      // dimension 必须等于所选模型的真实输出维度, 否则 VectorStore 写入维度
      // 校验失败 → 稠密召回静默退化为纯稀疏。常见值:
      //   text-embedding-3-small = 1536, text-embedding-3-large = 3072,
      //   bge-m3 / jina-embeddings-v3 = 1024
      "dimension": 1536
    },
    "reranker": {},

    // S3 图谱召回 (P3, 默认关闭)。enabled=true 后从 query 实体经 GraphStore.neighbors
    // 扩展关联记忆并入 RRF 融合 (骨架阶段恒空, 需实体抽取 + 写边落地后才有产出)。
    "graph_recall": {
      "enabled": false
    },

    // S2 后台记忆整合 (默认关闭)。enabled=true 后按 interval_seconds 周期去重/剪枝/
    // 画像归纳 (画像归纳需 llm 已配置; 软删走 N2 治理列, 不硬删)。
    "consolidation": {
      "enabled": false,
      "interval_seconds": 3600
    }
  },

  // U1 事件溯源会话内核 (默认开启 = 开箱可用的滑动窗口历史)
  // 会话存储为 append-only 事件表 (data/gateway/session_events.db, WAL),
  // 消息历史/滑动窗口/压缩全部从事件派生; 入站消息即持久事件
  // ("Model-visible ⟺ Logged"), 重启/断电容忍 (torn-tail 自动修复)。
  //   - enabled: false 时回退旧行为 (LLM 每回合只看当前 burst, 无历史窗口)
  //   - window_turns: 滑动窗口保留的最近轮数 (一轮 = 一问一答)
  //   - budget_tokens: 窗口 token 预算 (从最旧丢弃); null/0 = 不设预算
  "session": {
    "history": {
      "enabled": true,
      "window_turns": 10,
      "budget_tokens": null
    },

    // 阶段3-2 (M2): U1 会话压缩闭环 (默认关闭)。enabled=true 后, 回合完成时若某会话
    // 事件数 ≥ trigger_events, 后台用 LLM 把活跃窗口之外的旧对话前缀归纳为摘要,
    // 追加 turn.compressed replace 事件并保留 GC 被替代的内容事件 (遏制事件表无界
    // 增长)。tool.*/打断补偿/迁移标记事件不参与压缩与 GC (DenyGuard/torn-tail 依赖)。
    //   - trigger_events: 触发压缩的事件数阈值
    //   - keep_recent_messages: 保留最近 N 条内容消息不压缩 (须 ≥ 滑窗, 默认 20)
    //   - min_compress_messages: 前缀至少 N 条内容消息才值得压缩 (默认 6)
    "compression": {
      "enabled": false,
      "trigger_events": 60,
      "keep_recent_messages": 20,
      "min_compress_messages": 6
    }
  },

  // U3 门控策略化 (全局默认; Agent 级 AgentConfig.gating 可覆盖)。调整任一参数
  // 都不改代码。strategy 四档: off / keywords (默认) / llm-judge / hybrid。
  //   - locale: 门控词表语言 (zh_CN 默认中文词表 / en_US 英文词表), 词表在 locales。
  //   - weights: 评分权重覆盖 (缺省用框架默认, 见 isac/gating/profile.py)。
  //   - markers: question/request/consult 词表覆盖 (优先于 locale 词表)。
  //   - llm-judge/hybrid 用小模型判群聊发言相关性: llm_judge_max_per_minute 频率
  //     上限 (成本防护), 判定器故障/超限自动回落 keywords (fail-safe)。成本估算:
  //     每次判定约 1 次最便宜 fallback 档调用 (prompt≈系统语+消息, 输出 yes/no)。
  "gating": {
    "strategy": "keywords",
    "locale": "zh_CN",
    "reply_necessity_threshold": 80
    // "weights": { "content_question": 15, "content_request": 20 },
    // "markers": { "question": ["?", "吗"] },
    // "llm_judge_max_per_minute": 10,
    // "hybrid_escalate_band": 20
  },

  // P1 拟人化会话运行时 (默认关闭 = 每条消息即时处理, 零行为变化)
  // enabled=true 后:
  //   - debounce_seconds: 静默窗口秒数, 窗口内的连续消息合并为一轮处理 (0 = 不合并)
  //   - 新消息可唤醒 wait 工具、可打断正在思考的回合 (被打断的旧回复被抑制)
  //   - max_interrupts_per_turn: 单轮最多被打断次数
  //   - proactive: 主动任务调度 (经 ProactiveScheduler, 冷却按 session 隔离)
  // 每个 Agent 可在 AgentConfig.conversation 覆盖除 enabled 外的键。
  "conversation": {
    "enabled": false,
    "debounce_seconds": 1.5,
    "max_interrupts_per_turn": 1,
    "proactive": {
      "min_interval_seconds": 600,
      "poll_interval_seconds": 1.0,
      // 主动任务生产者 (S1, 默认全关 = 队列恒空, 不主动打扰)。idle_reengage_seconds>0
      // 时会话静默超阈值主动关心一次; 其余生产者启用后按记忆产出主动任务 (骨架阶段恒空)。
      "idle_reengage_seconds": 0,
      "date_reminder_enabled": false,
      "topic_followup_enabled": false,
      "memory_association_enabled": false
    }
  },

  // 全局人格配置 (Q2 激活, SPECIFICATION.md 1.6/1.7)。description 为空时各 Agent
  // 回落框架默认身份文案; 也可在 data/agents/<id>/config.jsonc 的 persona 段按
  // Agent 覆盖 (优先于此处全局值)。
  "persona": {
    "description": ""
  },

  // S4 跨平台身份归一 (P4, 默认关闭 = 走 UserMapper 原路径, 零行为变化)。
  // enabled=true 后入站消息经 IdentityResolver 归一到统一 person_id, 记忆按归一身份聚合;
  // heuristic_enabled=true 时按昵称启发式匹配 (低置信, 默认关防误合并)。
  "identity": {
    "enabled": false,
    "heuristic_enabled": false
  },

  // 多租户隔离 (O1/R6, 默认关闭 = 单租户零行为变化)
  // enabled=true 且填入非 default 的 org/tenant 时: 记忆命名空间加 org:tenant 前缀,
  // episodes 读写带租户谓词/打标 (多个租户进程共享同一数据目录时互不可见)。
  // R6: enabled=true 同时启用租户控制面 routes_tenants (CRUD 租户+成员, tenant:read/write
  // scope, SQLite 存 data/gateway/tenants.db); enabled=false 时路由不挂载。
  "tenancy": {
    "enabled": false,
    "organization_id": "default",
    "tenant_id": "default"
  },

  // 制品存储 (本地 FS, sha256 分桶)
  "artifacts": {
    "ttl_days": 7
  },

  // 控制面 (G1 Admin API)
  // api_token: Bearer Token (留空 = 开发模式无认证, 仅监听 127.0.0.1 时可接受);
  //            也可用环境变量 ISAC_API_TOKEN 覆盖。
  //            (Q0 修正: 此前样例误写 auth_token, 代码不读该键, 照样例配置会
  //             得到无认证的控制面)
  "control": {
    "enabled": true,
    "host": "127.0.0.1",
    // 2026-08-19: 与 docker-compose.yml / CI / QUICKSTART 全链路统一为 8765
    // (此前样例误写 8091, 照抄会与部署链路端口矛盾)。
    "port": 8765,
    "agents_dir": "data/agents",
    "api_token": "",
    // Fix-12 多 Token Scope 模型 (CONTROL_PLANE_SPEC.md §6.1, 可选)。配置 tokens[]
    // 后 api_token 扁平认证即被取代, 每条 {token, scopes, name?, tenant_id?}:
    //   scopes   —— 授权范围清单 ("*" = 全权限), 如 ["agents:read", "config:write"];
    //   name     —— 审计归因显示名 (缺省落不可逆 token 指纹, 绝不落裸 token);
    //   tenant_id —— #25 租户绑定: 非空时该 token 在 /tenants 端点只能操作自己的
    //                租户 (跨租户 403 TENANT_FORBIDDEN); 缺省 = 管理身份不限租户。
    // 未配置 tokens[] 时行为与上方单一 api_token 完全一致。
    // "tokens": [
    //   {"token": "ops-xxx", "name": "ops", "scopes": ["*"]},
    //   {"token": "t1-xxx", "name": "t1-bot", "tenant_id": "t1",
    //    "scopes": ["agents:read", "tenant:read", "tenant:write"]}
    // ],
    // T3-backend: 首登强制设密码 (对标 AstrBot password_change_required)。开箱控制面
    // 仅绑 127.0.0.1; setup_enabled=true 时 admin 端点首登态返回 428 SETUP_REQUIRED,
    // POST /api/v1/setup {password} 设密码后才可用 (密码经 PBKDF2 哈希, 不落明文)。
    // 轮换密码: isac password reset 后重新 POST /setup。配置 api_token/tokens 后 setup 自动跳过。
    "setup_enabled": true,
    "setup_state_path": "data/control/setup_state.json",
    // FE1 前后端分离 CORS (默认空 = 不加 CORSMiddleware, 同源/纯 API 场景零行为
    // 变化)。独立部署的前端 (如 http://localhost:5173) 消费本 API 时, 在此列出
    // 允许的 origin; 此时 Session Cookie 自动降 SameSite=Lax 跨源可带, 写操作
    // 另用 Bearer Token (双轨)。生产推荐同源反代 (前端与 /api 同 origin), 无需
    // 配置本字段。
    "cors": {
      "origins": [],
      "allow_credentials": true
    },
    // S5 Workflow 控制面 (O3/P5, 默认关闭)。enabled=true 后挂载 /api/v1/workflows
    // (list/get/start) 并按 base_dir 持久化工作流实例。
    "workflow": {
      "enabled": false,
      "base_dir": "data/workflows"
    },
    // U6 信任分级倒转: 有 manifest.jsonc 的原生插件**默认隔离加载** (子进程,
    // trust 缺省=sandboxed), 市场/git/url/upload 安装的插件未显式声明 hosted 即进沙箱。
    // 仅当 manifest 声明 trust: "hosted" 且目录名列在下方 trust_hosted 清单内
    // (运营方显式确认信任) 才在宿主进程内加载。无 manifest 的 AstrBot/MaiBot 兼容层
    // 插件无法隔离, 仍在宿主进程内 (降级承诺, 见 PLUGIN_COMPATIBILITY.md)。
    "plugins": {
      // trust_hosted: 运营方显式确认信任、允许宿主进程内加载的插件目录名清单
      // (须同时 manifest 声明 trust: "hosted" 才生效)。
      "trust_hosted": [],
      // Fix-31: 部署方强制隔离清单 (覆盖一切 manifest 声明)。填插件目录名列表,
      // 或 "*" 表示全部强制隔离。对无 manifest 的兼容层插件强制隔离会清晰报错。
      "isolated_plugins": [],
      // U6: 隔离宿主参数接线 (rlimits 仅 POSIX 生效; Windows 跳过资源限额)。
      "isolation": {
        // 子进程资源限额: cpu 秒数 / nofile 文件描述符数 / as 地址空间字节
        "rlimits": {
          "cpu": [60, 60],
          "nofile": [64, 64],
          "as": [268435456, 268435456]
        },
        // IPC 响应等待超时 (秒), 超时按子进程挂死处理 (terminate + respawn)
        "ipc_timeout_seconds": 30,
        // 子进程崩溃重启上限, 超过后放弃
        "max_restart_attempts": 3
      },
      // T6: 远程插件市场清单 URL。空 = 仅用本地 data/plugin_marketplace.jsonc。
      // 配置后控制面 httpx 拉取远程清单 (SSRF 校验 + 超时 + 缓存), 与本地合并。
      "marketplace_url": "",
      // T6: 是否允许经控制面安装/卸载/热重载插件。默认 true (控制面仅 127.0.0.1 可达)。
      // 暴露到外网时建议设 false, 经文件系统手动管理插件。
      "allow_install": true
    }
  },

  // R3: CLI 工具后端配置。workspace_root 固定为 data/workspace (LLM 文件操作沙箱,
  // read_file/write_file 相对它解析, 禁绝对路径/..越权)。bash_allowlist 默认空
  // (禁止所有命令); 配置允许的命令前缀让 bash 工具可用 (如 ["ls", "cat", "git"])。
  //
  // U5 approval: ask 档工具的人工审批配置。tools_policy 值设为 "ask" 的工具执行前
  // 需人工批准 (IM 回复 "同意 <审批码>"/"拒绝 <审批码>", 或控制面 POST
  // /api/v1/approvals/{id}/decide); timeout_seconds 秒内未回复自动拒绝 (fail-closed)。
  "tools": {
    "bash_allowlist": [],
    "approval": {
      "timeout_seconds": 300
    }
  },

  // R3: 全局 MCP Server 定义。assemble_agent 按 Agent 级 mcp_servers (允许名列表)
  // 查此表构造 MCPClient, connect + list_tools 把 MCP 工具桥接为 ISAC Tool 注册进
  // per-Agent ToolRegistry; Agent 停止/销毁时 disconnect。stdio 启动子进程,
  // http 用 httpx, sse 暂未实现 (会显式报错)。默认 servers 空 (不连接任何 MCP)。
  "mcp": {
    "servers": {
      // "example_stdio": {
      //   "transport": "stdio",
      //   "command": "npx",
      //   "args": ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"],
      //   "env": {}
      // },
      // "example_http": {
      //   "transport": "http",
      //   "url": "https://mcp.example.com",
      //   "token": ""
      // }
    }
  },

  // Channel 适配器 (Q0 起 4 个平台均在 main() 真实注册, enabled=true 即生效)
  "channels": {
    // OneBot/QQ: 反向 WebSocket 服务端, NapCat 等客户端连到 host:port
    // (Q0 修正: 此前样例误写 ws_reverse_url, 代码实际读 host/port)
    "onebot": {
      "enabled": false,
      "host": "127.0.0.1",
      "port": 8080,
      "access_token": ""
    },
    "telegram": {
      "enabled": false,
      "bot_token": ""
    },
    "discord": {
      "enabled": false,
      "bot_token": ""
    },
    // 飞书 (Lark): Webhook 回调模式 (S7)。在飞书开发者后台事件订阅里把
    // Request URL 填成 http://<你的外网地址>:<port>/feishu/events 即可。
    // 配置 encrypt_key 时事件会加密 (AES-256-CBC, SHA256(encrypt_key) 作 key);
    // 不配 encrypt_key 时走明文模式, 建议至少配 verification_token 校验来源。
    "feishu": {
      "enabled": false,
      "app_id": "",
      "app_secret": "",
      "verification_token": "",  // 明文模式校验 token; 加密模式可空
      "encrypt_key": "",         // 加密模式才需; 强烈建议配置
      "api_base": "https://open.feishu.cn",
      "webhook_host": "127.0.0.1",
      "webhook_port": 9099,
      "webhook_path": "/feishu/events"
    },
    // QQ 官方机器人 (Webhook 回调, S7): 与 OneBot 的 "qq" 并存不撞键, 二选一启用。
    // 在 QQ 开放平台 (bot.q.qq.com) 后台把回调地址填成
    // http://<你的外网地址>:<port>/qq_official/callback (端口限 80/443/8080/8443)。
    // secret 是机器人密钥 (用于 Ed25519 签名); 未配置则拒绝所有事件。
    "qq_official": {
      "enabled": false,
      "app_id": "",
      "secret": "",
      "sandbox": false,                       // 沙箱环境走 sandbox.api.sgroup.qq.com
      "api_base": "https://api.sgroup.qq.com",
      "webhook_host": "127.0.0.1",              // O11: 默认回环, 生产建议反代终止 TLS 后转发到此
      "webhook_port": 8443,                    // 官方限制端口 80/443/8080/8443
      "webhook_path": "/qq_official/callback"
    },
    // 微信 (O4 激活): 企业微信 (mode="wecom") 已实现 Webhook 回调 + 消息发送;
    // 公众号 (mode="mp") 仍是骨架。在回调 URL 里填 http://<外网>:<port>/wechat/events。
    // encoding_aes_key 配置时事件走 AES-256-CBC 加解密 (WXBizMsgCrypt 算法)。
    "wechat": {
      "enabled": false,
      "mode": "wecom",                 // "wecom" 企业微信 | "mp" 公众号
      "corp_id": "",                   // wecom: 企业 ID
      "agent_id": "",                  // wecom: 应用 AgentId
      "secret": "",                    // wecom: 应用 Secret / mp: AppSecret
      "app_id": "",                    // mp: 公众号 AppID
      "token": "",                     // 回调 URL 校验 Token
      "encoding_aes_key": "",          // 消息加解密 (可空=明文模式)
      "api_base": "https://qyapi.weixin.qq.com"
    },
    // WebChat: 零外部依赖的内置 HTTP 聊天通道, 开箱即可体验:
    //   发消息: curl -X POST http://127.0.0.1:8090/webchat/send \
    //           -d '{"session_id":"s1","user_id":"me","content":"你好"}'
    //   收回复: curl "http://127.0.0.1:8090/webchat/poll?session_id=s1"
    "webchat": {
      "enabled": true,
      "bind_host": "127.0.0.1",
      "bind_port": 8090,
      "max_message_age_seconds": 300
    }
  },

  // 监控告警 (I5)
  // 注意: 本节当前未被生产代码消费 (AlertManager 使用内置默认规则启动,
  // check_interval_seconds/webhook_url 均不生效), 保留作为规划位。
  "alerting": {
    "enabled": true,
    "check_interval_seconds": 30,
    "webhook_url": ""
  },

  // J1 计量 (用量与成本)
  "observability": {
    "usage": {
      "enabled": false,
      "flush_interval_seconds": 30
    }
  },

  // J4 SubAgent (默认关闭)
  "subagent": {
    "enabled": false
  }
}
